{
  "expo": {
    "name": "Elysia",
    "slug": "Elysia",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo(Purple_Spaced).png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "at.glaucus.elysia"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo(Purple_Spaced).png",
        "backgroundColor": "#000000"
      },
      "package": "at.glaucus.elysia"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "black"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
